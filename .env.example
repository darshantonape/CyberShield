# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# NVD API
# ---------------------------------------------------------------------------
# Optional but strongly recommended. Without a key the NVD rate limit is
# 5 requests / 30s; with one it is 50 / 30s.
# Request free at: https://nvd.nist.gov/developers/request-an-api-key
CYBERSHIELD_NVD_API_KEY=

# ---------------------------------------------------------------------------
# SSH to the authorized Linux laboratory target
# ---------------------------------------------------------------------------
# Key-based auth only. Password auth is not supported by design.
CYBERSHIELD_SSH_KEY_PATH=~/.ssh/cybershield_lab_ed25519

# ---------------------------------------------------------------------------
# Remediation safety
# ---------------------------------------------------------------------------
# Backend used to enforce firewall rules on the Linux target.
#   dryrun   - render the commands, execute nothing  (DEFAULT, safe)
#   nftables - apply real nftables rules over SSH
#   ufw      - apply real ufw rules over SSH
# Live enforcement must be turned on deliberately.
CYBERSHIELD_REMEDIATION_BACKEND=dryrun

# Minutes after which an applied isolation rule auto-reverts.
CYBERSHIELD_REMEDIATION_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Forgot password
# ---------------------------------------------------------------------------
# development - the reset link is printed to the server console (stderr) so
#               the flow can be tested without a mail server. Never use this
#               on a shared or production install.
# (anything else, or unset) - links are only ever delivered by SMTP.
CYBERSHIELD_ENV=

# Origin used in emailed reset links. Required whenever CyberShield is reached
# by anything other than localhost/127.0.0.1; without it such requests get no
# link, because an untrusted Host header could point the link at another server.
CYBERSHIELD_PUBLIC_BASE_URL=

# SMTP delivery. Leave CYBERSHIELD_SMTP_HOST empty to disable email.
CYBERSHIELD_SMTP_HOST=
CYBERSHIELD_SMTP_PORT=587
# starttls (default) | ssl | none
CYBERSHIELD_SMTP_SECURITY=starttls
CYBERSHIELD_SMTP_USERNAME=
CYBERSHIELD_SMTP_PASSWORD=
CYBERSHIELD_SMTP_FROM=
