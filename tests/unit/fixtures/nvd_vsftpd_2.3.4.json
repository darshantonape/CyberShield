    "descriptions": [
     {
      "lang": "en",
      "value": "Unspecified vulnerability in vsftpd 3.0.2 and earlier allows remote attackers to bypass access restrictions via unknown vectors, related to deny_file parsing."
     },
     {
      "lang": "es",
      "value": "Una vulnerabilidad no especificada en vsftpd versiones 3.0.2 y anteriores permite a los atacantes remotos omitir las restricciones de acceso por medio de vectores desconocidos, relacionados con el an\u00e1lisis deny_file."
     }
